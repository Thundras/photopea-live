<Window x:Class="PhotopeaLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Photopea Live" Height="900" Width="1440"
        Background="#252525">
    <!--
      Uses WebView2's own ZoomFactor (exposed directly on this control) to give Photopea
      AdGutterPx more virtual width than the window really has — see MainWindow.xaml.cs for why
      (Photopea's own layout math always reserves a fixed-width ad rail regardless of whether
      anything renders there). Note this is NOT the same as Electron's WebContents.setZoomFactor,
      which was unreliable in practice; this is WebView2's native implementation of the same
      concept, and per Microsoft's own docs is specifically the recommended property for "normal
      app scaling scenarios" (RasterizationScale, which was tried first, is documented as being
      for monitor-DPI tracking instead and isn't even exposed on this control).
    -->
    <wv2:WebView2 x:Name="Browser" />
</Window>
